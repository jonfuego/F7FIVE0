# F7FIVE0 settings. Setup writes a real .env next to this file with your
# answers and fresh secrets; this file documents every key. Restart the
# F7FIVE0 services after editing .env:
#   Restart-Service F7FIVE0-API, F7FIVE0-Stream, F7FIVE0-Web

# --- Core -------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Database (required) ----------------------------------------------------
DATABASE_URL=postgresql+psycopg://f7five0:CHANGE_ME@127.0.0.1:5432/f7five0

# --- Auth (required) --------------------------------------------------------
# Long random strings. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME
STREAM_HMAC_SECRET=CHANGE_ME_TOO
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
STREAM_URL_TTL_HOURS=8

# --- Media folders ----------------------------------------------------------
# Leave any blank to skip that library. Several folders for one library are
# separated by ; (D:\Movies;\\nas\media\Movies). Network shares work when
# the services run as an account that can read the share. Once folders are
# saved in Admin > Library folders, these keys are no longer used.
LIBRARY_ROOT_MOVIES=
LIBRARY_ROOT_TV=
LIBRARY_ROOT_MUSIC=
LIBRARY_ROOT_MUSIC_VIDEOS=
# How often folders are rescanned (minutes). Only new or changed files are probed.
FOLDER_SCAN_INTERVAL_MINUTES=30
# Seconds the automatic audio-analysis job waits between tracks. It analyzes one
# track per step (loudness, waveform, similarity) so new music gets smart-audio
# features without running the analyze-audio CLI. Lower = faster backfill.
AUDIO_ANALYSIS_THROTTLE_SEC=2

# --- Metadata (optional) ----------------------------------------------------
# Free key from themoviedb.org: matches movies and shows, adds posters,
# descriptions, cast. Without it, folder names and local artwork are used.
# A key saved in Admin > Metadata takes priority over this one.
TMDB_API_KEY=
# Sent to MusicBrainz with music lookups, as their terms ask.
MUSICBRAINZ_USER_AGENT_EMAIL=
ITUNES_ENABLED=true
AUDIODB_API_KEY=2
METADATA_TTL_DAYS=30

# --- Radarr / Sonarr / Lidarr (optional) ------------------------------------
# Fill in an API key to let that app own the library instead of the folder
# scanner. Radarr and Sonarr also turn on the Requests feature.
RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=
SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=
LIDARR_URL=http://127.0.0.1:8686
LIDARR_API_KEY=
# Shared secret the *arr webhooks send as a header.
ARR_WEBHOOK_SECRET=
# Where approved requests are added. Profile ids: GET /api/v3/qualityprofile
# on each app. Root folders must already exist in that app.
RADARR_QUALITY_PROFILE_ID=0
RADARR_ROOT_FOLDER=
SONARR_QUALITY_PROFILE_ID=0
SONARR_ROOT_FOLDER=
# Rewrite drive letters the *arr apps report (mapped only in your login
# session) to UNC paths the services can see. Example: N:=\\nas\media
PATH_REWRITE_RULES=

# --- Transcoding ------------------------------------------------------------
FFMPEG_BIN=C:\F7FIVE0\bin\ffmpeg.exe
FFPROBE_BIN=C:\F7FIVE0\bin\ffprobe.exe
# NVIDIA hardware encoding. Setup turns this on when it finds an NVIDIA GPU.
NVENC_ENABLED=false
TRANSCODE_CACHE_DIR=C:\F7FIVE0\data\transcode-cache
TRANSCODE_CACHE_MAX_GB=200
# Offline downloads of video that needs converting first (heavy; off by default).
DOWNLOAD_TRANSCODE_ENABLED=false

# --- Local data -------------------------------------------------------------
ART_ROOT=C:\F7FIVE0\data\art
METADATA_CACHE_ROOT=C:\F7FIVE0\data\metadata-cache
# Folder setup copies the Android app into (F7FIVE0-<version>.apk, plus
# F7FIVE0-<version>-armv7.apk in releases that have a 32-bit build). Every
# download is stamped with this server's addresses so the app fills them in.
F7FIVE0_DOWNLOADS_DIR=C:\F7FIVE0\data\downloads

# --- Security ---------------------------------------------------------------
# Extra semicolon-separated folders media may be streamed from, on top of the
# library folders (which are always allowed). The gateway fails closed: a file
# outside every allowed root is refused. Blank is fine; the library folders
# supply the roots.
STREAM_ALLOWED_ROOTS=
# DANGER, dev only: set to true to disable stream-root containment entirely and
# serve any path a signed URL names. Never set this on a reachable install.
# Setup never writes it.
STREAM_UNSAFE_ALLOW_ANY_PATH=false
# Extra peer IPs/CIDRs the backend trusts for forwarded headers on top of
# loopback (which is always trusted). The local front door reaches the backends
# over loopback, so this is usually fine as-is.
TRUSTED_PROXIES=127.0.0.1,::1
# Shared secret the front door (Caddy, written by Setup) sends to the Next web
# app as the X-F7five0-Proxy header so Next knows the request came through a
# trusted proxy and may forward the real client-IP headers to the backend.
# When blank, the Next proxy trusts nothing and strips client-IP headers from
# every hop, so a direct LAN browser cannot spoof an IP. Setup generates it.
TRUSTED_PROXY_SECRET=

# --- Native app -------------------------------------------------------------
# Oldest app version allowed to connect ("0.0.0" = no minimum).
MIN_CLIENT_VERSION_ANDROID=0.0.0
MIN_CLIENT_VERSION_ANDROID_TV=0.0.0

# --- Remote access ---------------------------------------------------------
# Address used away from home, written by Admin > Remote access (or
# installer\remote-access.ps1). Shown on the Account page with a QR code.
PUBLIC_URL=
# Home network address stamped into Android app downloads next to PUBLIC_URL.
# Blank: http://<this PC's LAN IP>:<WEB_PORT>. Set it if the PC has several
# network adapters and the wrong one gets picked.
HOME_URL=
# Folder the web app and the F7FIVE0-RemoteAccess task use to talk to each
# other. Default: <install folder>\data\remote-access.
#   REMOTE_ACCESS_DIR=
#   REMOTE_ACCESS_TASK=F7FIVE0-RemoteAccess

# --- Updates (Admin > Updates) ----------------------------------------------
# Admin > Updates checks GitHub once a day and updates the server from a
# release or from a Setup you upload. An uploaded Setup is installed only if
# it is exactly a published F7FIVE0 release (checked against GitHub), or has a
# valid Authenticode signature whose signer subject equals this setting. Blank
# turns the signature way off, which is right until releases are signed:
# unsigned test builds are always refused.
# Example: UPDATE_SIGNER_SUBJECT=CN=F7FIVE0 Release, O=F7FIVE0, C=US
UPDATE_SIGNER_SUBJECT=
# Where the web app and the F7FIVE0-Update task pass files to each other, the
# task name, the largest Setup accepted, and the file Setup writes the
# installed version to. Defaults: <install folder>\data\updates,
# F7FIVE0-Update, 1024, <install folder>\version.json.
#   UPDATES_DIR=
#   UPDATE_TASK=F7FIVE0-Update
#   UPDATE_MAX_SETUP_MB=1024
#   SERVER_VERSION_FILE=

# --- Passkeys (fingerprint / face sign-in) ----------------------------------
# On automatically when PUBLIC_URL is https; off on home-only http installs.
# Passkeys are tied to the address, so changing PUBLIC_URL orphans them.
# Leave these blank unless you need to override.
#   WEBAUTHN_RP_ID          domain passkeys belong to (default: PUBLIC_URL host)
#   WEBAUTHN_ORIGINS        comma list of web origins (default: https://<rp id>)
#   WEBAUTHN_ANDROID_CERT_SHA256  comma list of signing-cert fingerprints for
#                           the F7FIVE0 app (default: official release cert).
#                           Set this if you build and sign the app yourself.
#   WEBAUTHN_EXTRA_ANDROID_APPS   other apps: package=FINGERPRINT[|FP];...
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGINS=
# WEBAUTHN_ANDROID_CERT_SHA256=
# WEBAUTHN_EXTRA_ANDROID_APPS=

# --- Ports (the API and stream gateway stay on 127.0.0.1) -------------------
API_PORT=8001
STREAM_PORT=8002
WEB_PORT=3001

# --- Backups (scripts\backup-f7five0.ps1) -----------------------------------
BACKUP_DEST=
